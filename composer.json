{
  "name": "se7enxweb/primer",
  "description": "7x Primer 1.5 — PHP 8.x - 8.5.6 Support upgrade of symfony 1.4.x (branch 1.5) maintained by 7x",
  "type": "library",
  "license": "MIT",
  "keywords": ["primer", "symfony", "symfony1", "framework", "php8"],
  "homepage": "https://github.com/se7enxweb/primer",
  "authors": [
    {
      "name": "7x",
      "email": "info@se7enx.com",
      "homepage": "https://se7enx.com"
    },
    {
      "name": "Fabien Potencier",
      "email": "fabien.potencier@symfony-project.com"
    }
  ],
  "require": {
    "php": ">=8.0"
  },
  "require-dev": {
    "php": ">=8.0"
  },
  "autoload": {
    "psr-4": {
      "Se7enx\\Symfony1\\": "src/"
    },
    "classmap": [
      "lib/"
    ]
  },
  "autoload-dev": {
    "classmap": [
      "test/"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "vendor-dir": "vendor"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
